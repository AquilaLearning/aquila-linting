{
    "plugins": [
        "react"
    ],
    "rules": {
        "react/react-in-jsx-scope": "off"
    },
    "overrides": [
        {
            "files": [
                ".ts",
                ".tsx"
            ]
        }
    ],
    "settings": {
        "react": {
            "version": "18"
        }
    }
}
